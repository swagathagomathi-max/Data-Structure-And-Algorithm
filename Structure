// Simple Structure in Global Scope - Example 1

#include <stdio.h>

struct 
{
    int batch;
}bat1, bat2;

void main() 
{
   bat1.batch = 2022;
   bat2.batch = 2023;
   printf("I Year  :%d batch",bat1.batch);
   printf("\nII Year :%d batch",bat2.batch);
}

